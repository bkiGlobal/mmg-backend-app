# Contoh environment untuk deploy Docker.
# Salin ke ".env" di sebelah docker-compose.yml, lalu isi nilai aslinya.
# Jangan pernah commit file .env yang sudah terisi.

# ── Wajib ────────────────────────────────────────────────────────────────────
# Tanpa tiga nilai ini aplikasi menolak start.
# Buat SECRET_KEY dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=ganti-dengan-nilai-acak-panjang
ENCRYPTED_FILEFIELD_KEY=ganti-dengan-kunci-enkripsi
ENCRYPTED_FILEFIELD_SALT=ganti-dengan-salt-enkripsi

# PERINGATAN: mengganti dua nilai enkripsi di atas membuat berkas yang sudah
# terunggah tidak dapat dibuka kembali. Setel sekali, lalu simpan aman.

# ── Database ─────────────────────────────────────────────────────────────────
# Nilai ini dipakai layanan db pada docker-compose.
POSTGRES_DB=mmg
POSTGRES_USER=mmg
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# Host "db" merujuk nama layanan pada docker-compose.
DATABASE_URL=postgis://mmg:ganti-dengan-password-kuat@db:5432/mmg
DATABASE_ENGINE=django.contrib.gis.db.backends.postgis

# ── Aplikasi ────────────────────────────────────────────────────────────────
DEBUG=False
ALLOWED_HOSTS=mmg.example.com,127.0.0.1,localhost
WEB_PORT=8000

# ── HTTPS dan reverse proxy ─────────────────────────────────────────────────
# Aktifkan USE_X_FORWARDED_PROTO hanya bila ada proxy di depan yang benar-benar
# menyetel X-Forwarded-Proto. Bila aplikasi diekspos langsung tanpa proxy,
# biarkan False agar header tersebut tidak bisa dipalsukan klien.
USE_X_FORWARDED_PROTO=True
CSRF_TRUSTED_ORIGINS=https://mmg.example.com

# Saat masih menguji lewat HTTP biasa, setel SECURE_SSL_REDIRECT=False agar
# tidak terjadi redirect berulang.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://mmg.example.com

# ── Antrean export ──────────────────────────────────────────────────────────
# False di produksi: antrean dikerjakan layanan scheduler, bukan proses web,
# supaya request admin tidak menunggu pembuatan workbook.
EXPORT_JOBS_RUN_INLINE=False

# ── Opsional ────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
IMAGE_UPLOAD_MAX_WIDTH=1920
IMAGE_UPLOAD_MAX_HEIGHT=1920
IMAGE_UPLOAD_QUALITY=85

# GDAL_LIBRARY_PATH dan GEOS_LIBRARY_PATH sengaja dikosongkan. Di dalam image
# Linux, GeoDjango menemukan pustakanya sendiri; mengisinya justru mengunci
# image ke satu arsitektur.
